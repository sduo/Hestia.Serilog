<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
	  <LangVersion>12.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
	  <PackageId>Hestia.Serilog.Sinks.AliCloud.SLS</PackageId>
	  <Version>1.0.1</Version>
	  <Authors>SDuo</Authors>
	  <PackageDescription></PackageDescription>
	  <RepositoryUrl>https://github.com/sduo/Hestia.Serilog</RepositoryUrl>
	  <Copyright>Copyright (c) 2022-2026 SDuo</Copyright>
	  <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	  <PackageLicenseFile>LICENSE</PackageLicenseFile>
	  <PackageIcon>icon.png</PackageIcon>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
	<ItemGroup>
		<None Include="../../LICENSE" Pack="true" Visible="false" PackagePath="" />
		<None Include="../../icon.png" Pack="true" Visible="false" PackagePath="" />
		<None Include="../../README.md" Pack="true" Visible="false" PackagePath="" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Protobuf\" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Google.Protobuf" Version="3.35.1" />
	  <PackageReference Include="Hestia.Core" Version="1.1.6" />		
	  <PackageReference Include="Hestia.Security" Version="1.1.10" />
	  <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\..\Hestia.Serilog.Abstractions\src\Hestia.Serilog.Abstractions.csproj" />
	</ItemGroup>
	<Choose>
		<When Condition="'$(TargetFramework)' == 'net6.0'">
			<ItemGroup>				
				<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
				<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
				<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
			</ItemGroup>
		</When>
		<Otherwise>
			<ItemGroup>
				<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
				<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
				<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
			</ItemGroup>
		</Otherwise>
	</Choose>

</Project>
